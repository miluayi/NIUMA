IDI_ICON1 ICON DISCARDABLE NIUMA_APP_ICON_PATH
#include <windows.h>
#include "../src/AppVersion.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NIUMA_APP_VERSION_RESOURCE
PRODUCTVERSION NIUMA_APP_VERSION_RESOURCE
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "FileDescription", "NIUMA\0"
            VALUE "FileVersion", NIUMA_APP_VERSION "\0"
            VALUE "ProductName", "NIUMA\0"
            VALUE "ProductVersion", NIUMA_APP_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
